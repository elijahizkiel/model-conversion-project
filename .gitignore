# Git ignore rules for Ethio-ASR project

# Virtual Environment
venv/
.venv/

# Downloaded HuggingFace model weights & caches
models/original/
models/onnx/
models/quantized/
output/android/*/model.onnx
*.bin
*.safetensors
*.h5
*.ckpt
*.onnx

# Python caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Audio datasets
datasets/*.wav
datasets/*.mp3

# Logs & temp files
logs/
*.log
output/dist/
